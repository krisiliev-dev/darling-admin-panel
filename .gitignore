# --- secrets (NEVER commit) ---
.env
*.env
!.env.example

# --- python ---
__pycache__/
*.pyc
.venv/
venv/

# --- node / frontend build ---
node_modules/
frontend/dist/
frontend/node_modules/

# --- databases / data (state, not source) ---
*.db
*.db-journal
*.sqlite
*.sqlite3

# --- logs / os cruft ---
*.log
.DS_Store
Thumbs.db

# --- caddy runtime volumes are docker-managed, not in the tree ---

# never vendor runtime secrets — a .shopify_token.json was picked up by 'git add -A' on 2026-07-31
darling_core/_vendor/.shopify_token.json
darling_core/_vendor/*token*.json
**/.shopify_token.json

# sqlite CREATES a missing file, so a wrong DB_PATH leaves an empty database that reads as
# 'no such table' rather than 'file missing' — and a later attempt would read it as an empty
# catalogue instead of failing. Never let one be committed. (2026-07-31)
darling_core/_vendor/pipeline.db
darling_core/_vendor/*.db

backend/app/data/brands/brand_registry_v2.json
