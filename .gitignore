# --- secrets (NEVER commit) ---
.env
*.env
!.env.example

# --- python ---
__pycache__/
*.pyc
.venv/
venv/

# --- node / frontend build ---
node_modules/
frontend/dist/
frontend/node_modules/

# --- databases / data (state, not source) ---
*.db
*.db-journal
*.sqlite
*.sqlite3

