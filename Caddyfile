# Caddy — reverse proxy + automatic HTTPS (Let's Encrypt) for the Дарлинг admin panel.
# TLS is provisioned automatically once panel.darlinghome.bg resolves to this host and ports
# 80/443 are reachable. Caddy sets X-Forwarded-For to the real client IP, which the backend
# trusts via TRUST_PROXY=1 (so the auth rate-limiter keys on the true client).

{
	email anthropic@vkriss.com
}

panel.darlinghome.bg {
	encode gzip

	# ⚠ TEMPORARY DIAGNOSTIC (2026-07-27): lower the TLS floor to 1.0 to test whether Barsy's
	# webhook-probe client (which reports "status 0"/no-response at registration) is failing a
	# modern-TLS handshake. If confirmed, the clean fix is a separate hooks.darlinghome.bg with the
	# low floor while this host reverts to Caddy's secure default (TLS 1.2+). REVERT after the test.
	tls {
		protocols tls1.0 tls1.3
	}

	# API + webhook receivers → backend container (compose service name "panel")
	@backend path /api/* /webhooks/*
	handle @backend {
		reverse_proxy panel:8770
	}

	# Single-page app: serve built static assets, fall back to index.html for client routes
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
