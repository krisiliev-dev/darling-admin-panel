# Caddy — reverse proxy + automatic HTTPS (Let's Encrypt) for the Дарлинг admin panel.
# TLS is provisioned automatically once panel.darlinghome.bg resolves to this host and ports
# 80/443 are reachable. Caddy sets X-Forwarded-For to the real client IP, which the backend
# trusts via TRUST_PROXY=1 (so the auth rate-limiter keys on the true client).

{
	email anthropic@vkriss.com
}

panel.darlinghome.bg {
	encode gzip

	# Issue an RSA cert instead of Caddy's default ECDSA (which chains to ISRG Root X2). Older HTTP
	# clients — e.g. Barsy's webhook probe, which fails with "status 0" at registration — may not
	# support ECDSA certs or trust ISRG Root X2. RSA 2048 chains to the broadly-trusted ISRG Root X1
	# and keeps TLS 1.2+ (no security downgrade). `key_type` IS a valid Caddy directive (validated
	# before deploy) — unlike the removed tls1.0 protocol that crash-looped earlier.
	tls {
		key_type rsa2048
	}

	# Agent doorbell — STANDALONE service (repo Lora-git-hub/darling-doorbell, its own
	# container `darling-doorbell` on this compose network; owner decision 2026-08-05:
	# kept apart from this app). Wake-up signals between the Claude agent sessions —
	# carries no payload and no secrets; rate-limited app-side. handle_path strips /bell.
	handle_path /bell/* {
		reverse_proxy darling-doorbell:8300
	}

	# Newsletter — listmonk admin UI + opt-in confirmation links (own compose stack at
	# /home/darling/listmonk, NOT part of this app; owner decision 2026-08-05, listmonk
	# hybrid). Storefront subscriptions go through the panel backend proxy, not here.
	# Subpath quirks (probed live 2026-08-05): listmonk 307s to UNPREFIXED /admin/* (the
	# owner landed on the PANEL login) and hardcodes /public/* asset paths even with
	# root_url set — hence the Location rewrite and the extra /public route below.
	redir /listmonk /listmonk/admin 302
	handle_path /listmonk/* {
		reverse_proxy darling-listmonk:9000 {
			header_down Location "^/((admin|public|api|subscription|uploads|health).*)$" "/listmonk/$1"
		}
	}

	# listmonk's unprefixed absolute asset paths (panel SPA uses /assets/*, no conflict)
	handle /public/* {
		reverse_proxy darling-listmonk:9000
	}

	# API + webhook receivers → backend container (compose service name "panel")
	@backend path /api/* /webhooks/*
	handle @backend {
		reverse_proxy panel:8770
	}

	# Single-page app: serve built static assets, fall back to index.html for client routes
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
